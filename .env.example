APP_NAME="Weather Forecast Collector"
APP_ENV=production
# Optional: generated per container start when empty (nothing is encrypted at rest).
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8090

# Host ports published by docker compose
APP_PORT=8090
DB_FORWARD_PORT=5441

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Database (docker compose overrides DB_HOST/DB_PORT to point at the `db` service)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5441
DB_DATABASE=weather
DB_USERNAME=weather
DB_PASSWORD=weather

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=sync

# --- Weather collection ---------------------------------------------------------
# Required for WeatherAPI (free key: https://www.weatherapi.com/signup.aspx).
# Without it the WeatherAPI run is recorded as failed and Open-Meteo still works.
WEATHERAPI_KEY=

# Days ahead to request; clamped per provider (Open-Meteo 16, WeatherAPI free 3).
WEATHER_FORECAST_DAYS=7
# Scheduler tick. Idempotent: one successful fetch per provider/location/day,
# later ticks only retry providers that failed.
WEATHER_SCHEDULE_CRON="15 * * * *"
WEATHER_STORE_RAW_PAYLOAD=true
WEATHER_HTTP_TIMEOUT=15
WEATHER_HTTP_RETRIES=3
WEATHER_HTTP_RETRY_DELAY_MS=1000

# Seeded on first start; add more with `php artisan location:add`.
WEATHER_LOCATION_NAME=Larissa
WEATHER_LOCATION_LAT=39.639
WEATHER_LOCATION_LON=22.419
WEATHER_LOCATION_TIMEZONE=Europe/Athens

OPEN_METEO_ENABLED=true
WEATHERAPI_ENABLED=true
